{
  "name": "oidc",
  "desc": "OAuth 2.1 / OpenID Connect Provider for traP SSO.\ntraP の各サービス (traQ, knoQ, NeoShowcase 等) への SSO 基盤を提供する。\n",
  "tables": [
    {
      "name": "public.clients",
      "type": "BASE TABLE",
      "comment": "OAuth 2.1 / OIDC クライアントテーブル。\n各サービスは Client Credentials または Authorization Code フローでトークンを取得し、\nユーザーの所属グループ情報等を取得できる。\n",
      "columns": [
        {
          "name": "client_id",
          "type": "uuid",
          "nullable": false,
          "comment": "クライアントUUID (RFC 7591準拠)"
        },
        {
          "name": "client_secret_hash",
          "type": "text",
          "nullable": true,
          "comment": "ハッシュ化されたクライアントシークレット (confidential client用、public clientはNULL)"
        },
        {
          "name": "name",
          "type": "text",
          "nullable": false,
          "comment": "クライアント名 (traQ, knoQ, NeoShowcase等)"
        },
        {
          "name": "client_type",
          "type": "text",
          "nullable": false,
          "comment": "クライアントタイプ:\n- public: SPA等のシークレットを安全に保持できないクライアント\n- confidential: サーバーサイドでシークレットを保持できるクライアント\n"
        },
        {
          "name": "redirect_uris",
          "type": "jsonb",
          "nullable": false,
          "comment": "OAuth認可後のリダイレクトURI (JSON配列、複数環境対応)"
        },
        {
          "name": "post_logout_redirect_uris",
          "type": "jsonb",
          "nullable": false,
          "default": "'[]'::jsonb"
        },
        {
          "name": "allowed_origins",
          "type": "jsonb",
          "nullable": false,
          "default": "'[]'::jsonb"
        },
        {
          "name": "grant_types",
          "type": "jsonb",
          "nullable": false,
          "default": "'[\"authorization_code\"]'::jsonb"
        },
        {
          "name": "response_types",
          "type": "jsonb",
          "nullable": false,
          "default": "'[\"code\"]'::jsonb"
        },
        {
          "name": "scopes",
          "type": "jsonb",
          "nullable": false,
          "default": "'[\"openid\", \"profile\", \"email\"]'::jsonb"
        },
        {
          "name": "token_endpoint_auth",
          "type": "text",
          "nullable": false,
          "default": "'client_secret_basic'::text"
        },
        {
          "name": "id_token_alg",
          "type": "text",
          "nullable": false,
          "default": "'RS256'::text"
        },
        {
          "name": "status",
          "type": "text",
          "nullable": false,
          "default": "'active'::text"
        },
        {
          "name": "created_at",
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "CURRENT_TIMESTAMP",
          "comment": "作成日時"
        },
        {
          "name": "updated_at",
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "CURRENT_TIMESTAMP",
          "comment": "更新日時"
        }
      ],
      "indexes": [
        {
          "name": "clients_pkey",
          "def": "CREATE UNIQUE INDEX clients_pkey ON public.clients USING btree (client_id)",
          "table": "public.clients",
          "columns": [
            "client_id"
          ],
          "comment": "主キー"
        }
      ],
