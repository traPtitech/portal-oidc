          "comment": "主キー"
        }
      ],
      "triggers": [
        {
          "name": "trg_clients_set_updated_at",
          "def": "CREATE TRIGGER trg_clients_set_updated_at BEFORE UPDATE ON public.clients FOR EACH ROW EXECUTE FUNCTION set_updated_at()"
        },
        {
          "name": "trg_clients_revoke_sessions",
          "def": "CREATE TRIGGER trg_clients_revoke_sessions AFTER UPDATE OF status ON public.clients FOR EACH ROW WHEN (((old.status IS DISTINCT FROM new.status) AND (new.status \u003c\u003e 'active'::text))) EXECUTE FUNCTION revoke_inactive_client_sessions()"
        }
      ],
      "labels": [
        {
          "name": "OAuth2/OIDC",
          "virtual": true
        }
      ]
    },
