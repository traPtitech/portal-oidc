{
  "alias": "portal-oidc",
  "description": "portal-oidc OIDC conformance test",
  "server": {
    "discoveryUrl": "${DISCOVERY_URL}"
  },
  "client": {
    "client_id": "${CLIENT_ID}",
    "client_secret": "${CLIENT_SECRET}"
  },
  "client_secret_post": {
    "client_id": "${CLIENT_SECRET_POST_ID}",
    "client_secret": "${CLIENT_SECRET_POST_SECRET}"
  },
  "client2": {
    "client_id": "${CLIENT2_ID}",
    "client_secret": "${CLIENT2_SECRET}"
  },
  "override": {
    "oidcc-prompt-login": {
      "browser": [
        {
          "match": "http://host.docker.internal:8080/oauth2/authorize*",
          "tasks": [
            {
              "task": "Login",
              "optional": true,
              "match": "http://host.docker.internal:8080/login*",
              "commands": [
                ["wait", "xpath", "//*", 10, "(?s).*Login.*", "update-image-placeholder-optional"],
                ["text", "name", "username", "testuser", "optional"],
                ["text", "name", "password", "password", "optional"],
                ["click", "css", "button[type='submit']"]
              ]
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [
                ["wait", "id", "submission_complete", 10]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-max-age-1": {
      "browser": [
        {
          "match": "http://host.docker.internal:8080/oauth2/authorize*",
          "tasks": [
            {
              "task": "Login",
              "optional": true,
              "match": "http://host.docker.internal:8080/login*",
              "commands": [
                ["wait", "xpath", "//*", 10, "(?s).*Login.*", "update-image-placeholder-optional"],
                ["text", "name", "username", "testuser", "optional"],
                ["text", "name", "password", "password", "optional"],
                ["click", "css", "button[type='submit']"]
              ]
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [
                ["wait", "id", "submission_complete", 10]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-ensure-registered-redirect-uri": {
      "browser": [
        {
          "match": "http://host.docker.internal:8080/oauth2/authorize*",
          "tasks": [
            {
              "task": "Verify invalid redirect URI error page",
              "match": "http://host.docker.internal:8080/oauth2/authorize*",
              "commands": [
                ["wait", "xpath", "//*", 10, "(?s).*invalid_request.*", "update-image-placeholder"]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-ensure-request-object-with-redirect-uri": {
      "browser": [
        {
          "match": "http://host.docker.internal:8080/oauth2/authorize*",
          "tasks": [
            {
              "task": "Verify invalid redirect URI error page",
              "match": "http://host.docker.internal:8080/oauth2/authorize*",
              "commands": [
                ["wait", "xpath", "//*", 10, "(?s).*invalid_request.*", "update-image-placeholder"]
              ]
            }
          ]
        }
      ]
    }
  }
}
