{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Docker images (non-major)",
      "matchDatasources": ["docker"],
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Docker images (major)",
      "matchDatasources": ["docker"],
      "automerge": false,
      "matchUpdateTypes": ["major"]
    },

    // for conformance suite test
    {
      "description": "Keep MongoDB aligned with the conformance suite; review this range when upgrading the suite",
      "matchManagers": ["docker-compose"],
      "matchFileNames": [".github/conformance/docker-compose.yml"],
      "matchPackageNames": ["mongo"],
      "allowedVersions": "/^6\\.0\\.\\d+$/",
    },
    {
      "matchManagers": ["docker-compose"],
      "matchPackageNames": [
        "ghcr.io/traptitech/portal-oidc/conformance-httpd",
        "ghcr.io/traptitech/portal-oidc/conformance-server",
      ],
      "versioning": "regex:^release-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "groupName": "OpenID conformance suite images",
      "minimumGroupSize": 2,
    }
  ]
}
